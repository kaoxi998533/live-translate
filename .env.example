APP_ENV=development
API_BASE_URL=http://localhost:8080

DATABASE_URL=postgres://live_translate:live_translate@localhost:5432/live_translate?sslmode=disable
REDIS_URL=redis://localhost:6379/0
MIGRATION_PATH=../../infra/migrations/001_initial.sql
RATE_LIMIT_PER_MINUTE=120

JWT_ISSUER=live-translate-platform
JWT_AUDIENCE=live-translate-web
JWT_SECRET=change-me-in-development

BILLING_PRIMARY_PROVIDER=wechat_pay

STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_PREMIUM_PRICE_ID=price_change_me

WECHAT_PAY_APP_ID=wx_change_me
WECHAT_PAY_MCH_ID=change_me
WECHAT_PAY_API_V3_KEY=change_me
WECHAT_PAY_PRIVATE_KEY_PATH=./secrets/wechat-pay-private-key.pem
WECHAT_PAY_CERT_SERIAL_NO=change_me
WECHAT_PAY_NOTIFY_URL=https://api.example.com/v1/billing/wechat/notify

OPENAI_API_KEY=sk-proj-change-me
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_OUTPUT_SPEED=1
OPENAI_REALTIME_VAD_SILENCE_DURATION_MS=450
OPENAI_REALTIME_VAD_THRESHOLD=0.78
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=250
OPENAI_REALTIME_SESSION_TTL_SECONDS=600
